PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/questsave
JWT_SECRET=change-me
# Production: https://questsave.orzn.app
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Brevo — sender must be noreply@questlabs.cc
BREVO_API_KEY=
MAIL_FROM_NAME=QuestSave
MAIL_FROM_EMAIL=noreply@questlabs.cc

# Pinterest, plus TikTok / X last-resort fallbacks
YTDLP_IMPERSONATE=chrome
# Optional Netscape cookies.txt (Render secret file: /etc/secrets/cookies.txt)
# YTDLP_COOKIES=

# RapidAPI key must be subscribed to YouTube, Instagram, and Facebook
RAPIDAPI_KEY=
