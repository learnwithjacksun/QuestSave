PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/questsave
JWT_SECRET=change-me
# Production: https://questsave.orzn.app
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Brevo — sender must be noreply@questlabs.cc
BREVO_API_KEY=
MAIL_FROM_NAME=QuestSave
MAIL_FROM_EMAIL=noreply@questlabs.cc

# Stream Saver — all platforms except TikTok (tikwm)
STREAMSAVER_API_BASE=https://streamsaver-api.orzn.app
# STREAMSAVER_TIMEOUT_MS=90000

# Last-resort fallbacks (TikTok / Stream Saver failures)
YTDLP_IMPERSONATE=chrome
# Optional Netscape cookies.txt (Render secret file: /etc/secrets/cookies.txt)
# YTDLP_COOKIES=

# Optional RapidAPI fallback for YouTube, Instagram, and Facebook
RAPIDAPI_KEY=
