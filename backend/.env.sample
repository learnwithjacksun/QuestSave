PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/questsave
JWT_SECRET=change-me
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Brevo API — sender must be noreply@questlabs.cc
BREVO_API_KEY=
MAIL_FROM_NAME=QuestSave
MAIL_FROM_EMAIL=noreply@questlabs.cc

# yt-dlp must be installed and on PATH. ffmpeg is required to merge video+audio.
# For YouTube, also install a JS runtime (deno or node) and ideally curl_cffi:
#   pip install -U "yt-dlp[default]" "curl_cffi>=0.10,<0.13"
YTDLP_PATH=yt-dlp
YTDLP_TIMEOUT_MS=60000
# Optional: Netscape cookies.txt export (recommended for YouTube bot checks)
YTDLP_COOKIES=
# Optional alternative: chrome | chromium | firefox (profile must exist on the server)
YTDLP_COOKIES_FROM_BROWSER=
# Optional: chrome (requires curl_cffi). Helps YouTube / X extraction.
YTDLP_IMPERSONATE=
