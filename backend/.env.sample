PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/questsave
JWT_SECRET=change-me
# Production: https://questsave.orzn.app (CORS uses this plus the hardcoded Orizon origin)
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development

# Brevo API — sender must be noreply@questlabs.cc
BREVO_API_KEY=
MAIL_FROM_NAME=QuestSave
MAIL_FROM_EMAIL=noreply@questlabs.cc

# yt-dlp + ffmpeg are installed in the Render Docker image (see RENDER.md).
# Local: pip install -U "yt-dlp[default]" "curl_cffi>=0.10,<0.13" and install ffmpeg.
YTDLP_PATH=yt-dlp
YTDLP_TIMEOUT_MS=60000
# Render: set to chrome. Requires curl_cffi (included in the Docker image).
YTDLP_IMPERSONATE=chrome
# Optional: Netscape cookies.txt for YouTube / Instagram / Facebook bot checks.
# On Render, upload a Secret File named cookies.txt and set:
#   YTDLP_COOKIES=/etc/secrets/cookies.txt
YTDLP_COOKIES=
# Optional alternative: chrome | chromium | firefox — only works when the browser profile exists locally.
YTDLP_COOKIES_FROM_BROWSER=
